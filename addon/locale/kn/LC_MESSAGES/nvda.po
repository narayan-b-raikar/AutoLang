msgid "&Default language"
msgstr "ಡೀಫಾಲ್ಟ್ &ಭಾಷೆ"

msgid "Additional language script configuration"
msgstr "ಹೆಚ್ಚುವರಿ ಭಾಷಾ ಲಿಪಿ ಕಾನ್ಫಿಗರೇಶನ್"

msgid "Additional language script configuration..."
msgstr "ಹೆಚ್ಚುವರಿ ಭಾಷಾ ಲಿಪಿ ಕಾನ್ಫಿಗರೇಶನ್..."

msgid "Always in the default language"
msgstr "ಯಾವಾಗಲೂ ಡೀಫಾಲ್ಟ್ ಭಾಷೆಯಲ್ಲಿ"

msgid "Arabic script text (Arabic, Urdu etc.)"
msgstr "ಅರೇಬಿಕ್ ಲಿಪಿ ಪಠ್ಯ (ಅರೇಬಿಕ್, ಉರ್ದು ಇತ್ಯಾದಿ)"

msgid "AutoLang"
msgstr "AutoLang"

msgid "Checking the synthesizers. Please wait."
msgstr "ಸಿಂಥಸೈಸರ್‌ಗಳನ್ನು ಪರಿಶೀಲಿಸಲಾಗುತ್ತಿದೆ. ದಯವಿಟ್ಟು ಕಾಯಿರಿ."

msgid "Chinese, Japanese and Korean text"
msgstr "ಚೈನೀಸ್, ಜಪಾನೀಸ್ ಮತ್ತು ಕೊರಿಯನ್ ಪಠ್ಯ"

msgid "Cyrillic script text (Russian etc.)"
msgstr "ಸಿರಿಲಿಕ್ ಲಿಪಿ ಪಠ್ಯ (ರಷ್ಯನ್ ಇತ್ಯಾದಿ)"

msgid "Devanagari script text (Hindi, Marathi etc.)"
msgstr "ದೇವನಾಗರಿ ಲಿಪಿ ಪಠ್ಯ (ಹಿಂದಿ, ಮರಾಠಿ ಇತ್ಯಾದಿ)"

msgid "Find the language automatically from the script"
msgstr "ಲಿಪಿಯಿಂದ ಭಾಷೆಯನ್ನು ತಾನಾಗಿ ಗುರುತಿಸಿ"

msgid "In the language of the text"
msgstr "ಪಠ್ಯದ ಭಾಷೆಯಲ್ಲಿ"

msgid "In the same language as the nearby text"
msgstr "ಹತ್ತಿರದ ಪಠ್ಯದ ಭಾಷೆಯಲ್ಲಿ"

msgid "Language to set up"
msgstr "ಸೆಟ್ ಮಾಡಬೇಕಾದ ಭಾಷೆ"

msgid "Latin script text (English etc.)"
msgstr "ಲ್ಯಾಟಿನ್ ಲಿಪಿ ಪಠ್ಯ (ಇಂಗ್ಲಿಷ್ ಇತ್ಯಾದಿ)"

msgid "Load synthesizers in advance (avoids delay)"
msgstr "ಸಿಂಥಸೈಸರ್‌ಗಳನ್ನು ಮೊದಲೇ ಲೋಡ್ ಮಾಡಿ (ವಿಳಂಬ ತಪ್ಪಿಸಲು)"

msgid "Punctuation level"
msgstr "ವಿರಾಮಚಿಹ್ನೆ ಮಟ್ಟ"

msgid "Read &numbers in"
msgstr "&ಅಂಕೆಗಳನ್ನು ಓದುವ ಭಾಷೆ"

msgid "Read &symbols in"
msgstr "&ಚಿಹ್ನೆಗಳನ್ನು ಓದುವ ಭಾಷೆ"

msgid "Same as NVDA setting"
msgstr "NVDA ಸೆಟ್ಟಿಂಗ್‌ನಂತೆಯೇ"

msgid "Synthesizer"
msgstr "ಸಿಂಥಸೈಸರ್"

msgid "Synthesizer for this language"
msgstr "ಈ ಭಾಷೆಗೆ ಸಿಂಥಸೈಸರ್"

msgid "Tell the synthesizer which language is being read"
msgstr "ಯಾವ ಭಾಷೆ ಓದಲಾಗುತ್ತಿದೆ ಎಂದು ಸಿಂಥಸೈಸರ್‌ಗೆ ತಿಳಿಸಿ"

msgid ""
"The {synth} synthesizer could not be started. Please check that it is "
"installed."
msgstr ""
"{synth} ಸಿಂಥಸೈಸರ್ ಪ್ರಾರಂಭವಾಗಲಿಲ್ಲ. ಅದು ಇನ್‌ಸ್ಟಾಲ್ ಆಗಿದೆಯೇ ಎಂದು ಪರಿಶೀಲಿಸಿ."

msgid "Voice, rate, pitch and other settings..."
msgstr "ಧ್ವನಿ, ರೇಟ್, ಪಿಚ್ ಮತ್ತು ಇತರ ಸೆಟ್ಟಿಂಗ್‌ಗಳು..."

msgid "{language} - settings of {synth}"
msgstr "{language} - {synth} ಸೆಟ್ಟಿಂಗ್‌ಗಳು"

msgid "{language}: {setting}"
msgstr "{language}: {setting}"
